{
  "name": "@pitchroom/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:offline": "vitest run --reporter=verbose",
    "eval:live": "node --import tsx src/live-eval-cli.ts",
    "eval:clarify:offline": "node --import tsx src/clarification-offline-cli.ts",
    "eval:clarify:live": "node --import tsx src/clarification-live-cli.ts"
  },
  "dependencies": {
    "@pitchroom/agent": "workspace:*",
    "@pitchroom/domain": "workspace:*",
    "@pitchroom/testkit": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
